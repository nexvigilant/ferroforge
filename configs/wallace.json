{
  "domain": "wallace.nexvigilant.com",
  "url_pattern": "/*",
  "title": "Wallace Protocol",
  "description": "Fearless Rust code quality scanner — classifies unwrap/expect/clone violations with test-awareness and context analysis",
  "tools": [
    {
      "name": "wallace-scan-workspace",
      "description": "Scan entire nexcore workspace for unwrap/expect/clone violations. Classifies each as TestCode, DocComment, Mechanical, SignatureLift, or Necessary. Returns per-crate counts and actionable totals.",
      "parameters": [
        {
          "name": "crates_dir",
          "description": "Path to crates directory (default: crates/)",
          "type": "string",
          "required": false
        },
        {
          "name": "actionable_only",
          "description": "If true, return only actionable violations (Mechanical + SignatureLift)",
          "type": "boolean",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "ok | error" },
          "total_violations": { "type": "integer" },
          "total_actionable": { "type": "integer" },
          "crate_count": { "type": "integer" },
          "crates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "total": { "type": "integer" },
                "actionable": { "type": "integer" }
              }
            }
          }
        },
        "required": ["status"]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "wallace-scan-crate",
      "description": "Scan a single crate for unwrap/expect/clone violations with full classification breakdown. Returns per-violation file, line, kind, and classification.",
      "parameters": [
        {
          "name": "crate_name",
          "description": "Name of the crate to scan (e.g. nexcore-mcp)",
          "type": "string",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "ok | error" },
          "name": { "type": "string" },
          "total": { "type": "integer" },
          "actionable": { "type": "integer" },
          "unwrap_count": { "type": "integer" },
          "expect_count": { "type": "integer" },
          "clone_count": { "type": "integer" },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer" },
                "kind": { "type": "string" },
                "classification": { "type": "string" },
                "context": { "type": "string" }
              }
            }
          }
        },
        "required": ["status"]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    },
    {
      "name": "wallace-pipeline",
      "description": "Full Wallace Protocol battlefield report: scan + classify + breakdown. Returns classification counts (TestCode, DocComment, Mechanical, SignatureLift, Necessary) and top offenders by actionable violations.",
      "parameters": [
        {
          "name": "crates_dir",
          "description": "Path to crates directory (default: crates/)",
          "type": "string",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "description": "ok | error" },
          "classification_breakdown": {
            "type": "object",
            "properties": {
              "test_code": { "type": "integer" },
              "doc_comment": { "type": "integer" },
              "detection_code": { "type": "integer" },
              "allowed": { "type": "integer" },
              "mechanical": { "type": "integer" },
              "signature_lift": { "type": "integer" },
              "necessary_clone": { "type": "integer" }
            }
          },
          "total": { "type": "integer" },
          "actionable": { "type": "integer" },
          "top_offenders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "crate": { "type": "string" },
                "actionable": { "type": "integer" },
                "total": { "type": "integer" }
              }
            }
          }
        },
        "required": ["status"]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      }
    }
  ]
}
