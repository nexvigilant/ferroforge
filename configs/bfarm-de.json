{
  "domain": "www.bfarm.de",
  "url_pattern": "/*",
  "title": "BfArM Germany Drug Safety",
  "description": "German Federal Institute for Drugs and Medical Devices \u2014 Rote-Hand-Briefe (dear doctor letters), UAW database (adverse drug reactions), national authorisation register, risk information for nationally-authorised drugs outside EMA centralised procedure",
  "tools": [
    {
      "name": "search-uaw-reports",
      "description": "Search UAW-Datenbank (German national adverse drug reaction database). German equivalent to Yellow Card/FAERS for nationally-authorised drugs.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name (brand or INN)",
          "required": true
        },
        {
          "name": "reaction",
          "type": "string",
          "description": "MedDRA PT or German reaction term",
          "required": false
        },
        {
          "name": "limit",
          "type": "int",
          "description": "Max results",
          "required": false,
          "default": "25"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_bfarm_de_proxy.py"
    },
    {
      "name": "get-rote-hand-briefe",
      "description": "Get Rote-Hand-Briefe (Dear Healthcare Professional letters) for a drug. These are urgent safety communications from marketing authorisation holders to German prescribers.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        },
        {
          "name": "year",
          "type": "int",
          "description": "Year filter",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "letters": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_bfarm_de_proxy.py"
    },
    {
      "name": "get-risiko-information",
      "description": "Get BfArM Risiko-Information (risk information bulletins). Germany-specific safety signals and benefit-risk reassessments.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_bfarm_de_proxy.py"
    },
    {
      "name": "search-arzneimittel-register",
      "description": "Search German national drug authorisation register for products not in EMA centralised procedure.",
      "parameters": [
        {
          "name": "query",
          "type": "string",
          "description": "Search query (drug name, substance, or authorisation number)",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_bfarm_de_proxy.py"
    },
    {
      "name": "get-stufenplan-status",
      "description": "Check Stufenplan (staged risk assessment procedure) status for a drug. German formal process for evaluating emerging safety signals.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "stufenplan_active": {
            "type": "boolean"
          },
          "current_stage": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_bfarm_de_proxy.py"
    },
    {
      "name": "get-fachinformation",
      "description": "Get German Fachinformation (SmPC equivalent) from BfArM. Professional product information for licensed drugs in Germany.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "fachinfo_url": {
            "type": "string"
          },
          "warnings": {
            "type": "string"
          },
          "contraindications": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_bfarm_de_proxy.py"
    }
  ],
  "proxy": "scripts/www_bfarm_de_proxy.py"
}
