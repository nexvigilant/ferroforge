{
  "domain": "www.sfda.gov.sa",
  "url_pattern": "/*",
  "title": "Saudi SFDA Drug Safety",
  "description": "Saudi Food and Drug Authority \u2014 adverse reaction reports, safety communications, drug registration, and recall actions",
  "handler": "rust-native",
  "tools": [
    {
      "name": "search-drug-registry",
      "description": "Search Saudi Arabia drug registration database",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name (brand or generic)",
          "required": true
        },
        {
          "name": "limit",
          "type": "int",
          "description": "Maximum results",
          "required": false,
          "default": "25"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "ok | error"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/generic_regulator_proxy.py"
    },
    {
      "name": "get-safety-alerts",
      "description": "Get Saudi Arabia drug safety alerts and communications",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "ok | error"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/generic_regulator_proxy.py"
    },
    {
      "name": "get-recall-actions",
      "description": "Get Saudi Arabia drug recall and withdrawal actions",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "ok | error"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/generic_regulator_proxy.py"
    },
    {
      "name": "get-pharmacovigilance-reports",
      "description": "Get Saudi Arabia pharmacovigilance and ADR reports",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "ok | error"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/generic_regulator_proxy.py"
    },
    {
      "name": "get-regulatory-classification",
      "description": "Get Saudi Arabia regulatory classification and approval status",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "ok | error"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/generic_regulator_proxy.py"
    }
  ],
  "proxy": "scripts/generic_regulator_proxy.py"
}
