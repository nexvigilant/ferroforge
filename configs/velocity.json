{
  "domain": "velocity.nexvigilant.com",
  "title": "Signal Velocity Tracker",
  "description": "Day-over-day ML signal detection trends. Query the last 14 days of nightly 50-drug pipeline results from Firestore.",
  "proxy": "scripts/velocity_proxy.py",
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": true
  },
  "tools": [
    {
      "name": "get-signal-velocity",
      "description": "Get the last 14 days of ML signal detection history. Shows per-drug ML probability trends, signal counts, and day-over-day velocity for 50 drugs.",
      "parameters": [],
      "outputSchema": {
        "type": "object",
        "properties": {
          "days": { "type": "integer" },
          "history": { "type": "array" }
        },
        "required": ["days", "history"]
      },
      "annotations": { "readOnlyHint": true, "destructiveHint": false }
    },
    {
      "name": "get-drug-trend",
      "description": "Get ML probability trend for a specific drug over the last 14 days.",
      "parameters": [
        {
          "name": "drug",
          "type": "string",
          "description": "Drug name to query",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "drug": { "type": "string" },
          "trend": { "type": "array" },
          "days": { "type": "integer" }
        },
        "required": ["drug", "trend"]
      },
      "annotations": { "readOnlyHint": true, "destructiveHint": false }
    }
  ]
}
