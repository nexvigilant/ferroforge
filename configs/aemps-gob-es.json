{
  "domain": "www.aemps.gob.es",
  "url_pattern": "/*",
  "title": "AEMPS Spain Drug Safety",
  "description": "Spanish Agency of Medicines and Medical Devices \u2014 FEDRA pharmacovigilance database (Sistema Espa\u00f1ol de Farmacovigilancia), safety alerts, nota informativa de seguridad, medicines register for nationally-authorised drugs",
  "tools": [
    {
      "name": "search-fedra-reports",
      "description": "Search FEDRA (Sistema Espa\u00f1ol de Farmacovigilancia de Medicamentos de Uso Humano) adverse reaction reports.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name (brand or DCI)",
          "required": true
        },
        {
          "name": "reaction",
          "type": "string",
          "description": "MedDRA PT",
          "required": false
        },
        {
          "name": "limit",
          "type": "int",
          "description": "Max results",
          "required": false,
          "default": "25"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aemps_gob_es_proxy.py"
    },
    {
      "name": "get-nota-informativa-seguridad",
      "description": "Get AEMPS Notas Informativas de Seguridad (Safety Information Notes) \u2014 Spanish regulatory safety communications.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        },
        {
          "name": "year",
          "type": "int",
          "description": "Year filter",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "notas": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aemps_gob_es_proxy.py"
    },
    {
      "name": "search-cima-register",
      "description": "Search CIMA (Centro de Informaci\u00f3n Online de Medicamentos de la AEMPS) \u2014 Spanish authorised medicines register.",
      "parameters": [
        {
          "name": "query",
          "type": "string",
          "description": "Drug name, active substance, or registration number",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aemps_gob_es_proxy.py"
    },
    {
      "name": "get-ficha-tecnica",
      "description": "Get Ficha T\u00e9cnica (Spanish SmPC equivalent) and Prospecto (patient leaflet) for a drug from CIMA.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "ficha_tecnica_url": {
            "type": "string"
          },
          "prospecto_url": {
            "type": "string"
          },
          "indications": {
            "type": "string"
          },
          "warnings": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aemps_gob_es_proxy.py"
    },
    {
      "name": "get-aemps-rmp",
      "description": "Get Spain-specific Risk Management Plan additional measures beyond EMA centralised RMP.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "additional_measures": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aemps_gob_es_proxy.py"
    },
    {
      "name": "get-alertas-farmacologicas",
      "description": "Get AEMPS alertas farmacol\u00f3gicas (pharmacological alerts) \u2014 Spanish urgent safety communications and drug recalls.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name (optional \u2014 returns recent alerts if omitted)",
          "required": false
        },
        {
          "name": "limit",
          "type": "int",
          "description": "Max results",
          "required": false,
          "default": "20"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "alertas": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aemps_gob_es_proxy.py"
    }
  ],
  "proxy": "scripts/www_aemps_gob_es_proxy.py"
}
