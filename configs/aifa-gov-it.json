{
  "domain": "www.aifa.gov.it",
  "url_pattern": "/*",
  "title": "AIFA Italy Drug Safety",
  "description": "Italian Medicines Agency \u2014 National Pharmacovigilance Network (Rete Nazionale di Farmacovigilanza), AIFA-specific RMPs, Note AIFA (prescribing restrictions), Dear Doctor Letters for nationally-authorised drugs",
  "tools": [
    {
      "name": "search-farmacovigilanza-reports",
      "description": "Search Italian National Pharmacovigilance Network (Rete Nazionale di Farmacovigilanza) adverse reaction reports.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name (brand or INN)",
          "required": true
        },
        {
          "name": "reaction",
          "type": "string",
          "description": "MedDRA PT",
          "required": false
        },
        {
          "name": "limit",
          "type": "int",
          "description": "Max results",
          "required": false,
          "default": "25"
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aifa_gov_it_proxy.py"
    },
    {
      "name": "get-note-aifa",
      "description": "Get Note AIFA (AIFA Notes) \u2014 prescribing restrictions and reimbursement conditions for a drug. Italy-specific constraints beyond SmPC.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "note_number": {
            "type": "string"
          },
          "restrictions": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aifa_gov_it_proxy.py"
    },
    {
      "name": "get-dear-doctor-letter",
      "description": "Get AIFA Dear Healthcare Professional letters (Nota Informativa Importante) for a drug.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        },
        {
          "name": "year",
          "type": "int",
          "description": "Year filter",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "letters": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aifa_gov_it_proxy.py"
    },
    {
      "name": "search-medicinali-register",
      "description": "Search Italian authorised medicinal products register (Banca Dati dei Medicinali).",
      "parameters": [
        {
          "name": "query",
          "type": "string",
          "description": "Drug name, active substance, or AIC number",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "results": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "results"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aifa_gov_it_proxy.py"
    },
    {
      "name": "get-aifa-rmp",
      "description": "Get Italy-specific Risk Management Plan elements. AIFA sometimes requires additional risk minimisation measures for Italian market.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name",
          "required": true
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "additional_measures": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aifa_gov_it_proxy.py"
    },
    {
      "name": "get-monitored-drugs-list",
      "description": "Get AIFA list of drugs under additional monitoring (Farmaci Sottoposti a Monitoraggio Addizionale). Italian equivalent to EMA additional monitoring.",
      "parameters": [
        {
          "name": "drug_name",
          "type": "string",
          "description": "Drug name (optional \u2014 returns all if omitted)",
          "required": false
        }
      ],
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "monitored": {
            "type": "boolean"
          },
          "drugs": {
            "type": "array"
          },
          "source_url": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false
      },
      "proxy": "scripts/www_aifa_gov_it_proxy.py"
    }
  ],
  "proxy": "scripts/www_aifa_gov_it_proxy.py"
}
